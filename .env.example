# Every setting the service recognises (FR-008). Copy this file to .env.
# It contains no secrets and is safe to commit.

# Required. Path to the SQLite database file.
DATABASE_PATH=./data/oms.db

# Optional. Defaults are shown.
PORT=3000
LOG_LEVEL=info
SCHEDULER_INTERVAL_MS=300000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000

# Optional. The background promotion job's bounds. Their product is the number of
# orders one tick may promote, which is a blocking-time budget rather than a
# throughput target: every chunk blocks the event loop for as long as it runs.
ORDER_PROMOTION_CHUNK_SIZE=100
ORDER_PROMOTION_MAX_ITERATIONS=10

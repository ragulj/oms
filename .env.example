# Every setting the service recognises (FR-008). Copy this file to .env.
# It contains no secrets and is safe to commit.

# Required. Path to the SQLite database file.
DATABASE_PATH=./data/oms.db

# Optional. Defaults are shown.
PORT=3000
LOG_LEVEL=info
SCHEDULER_INTERVAL_MS=300000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000

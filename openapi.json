    "/api/v1/orders/{id}/cancel": {
      "post": {
        "description": "Takes no request body. This is the only status change a caller can request; promotion to\n`processing` belongs to the background job alone, and there is no operation that sets an\narbitrary status.\n\nA conflict means the order is not in a state from which cancellation is legal. It is returned\nboth when the caller was simply late and when the transition was never legal from that state,\nbecause those are the same fact and telling them apart would require a read-then-write guard\nthat this system does not use.",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identifier of the order to cancel.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The order was pending and is now cancelled.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identifies this request in the service logs. Present on success and failure.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                },
                "example": {
                  "id": 42,
                  "customerId": 1,
                  "status": "cancelled",
                  "createdAtUs": 1757030400123456,
                  "updatedAtUs": 1757030400123457,
                  "totalMinor": 8447,
                  "lines": [
                    {
                      "id": 101,
                      "productId": 1,
                      "productDescription": "Widget",
                      "unitPriceMinor": 1299,
                      "quantity": 3,
                      "lineTotalMinor": 3897
                    },
                    {
                      "id": 102,
                      "productId": 2,
                      "productDescription": "Gadget",
                      "unitPriceMinor": 4550,
                      "quantity": 1,
                      "lineTotalMinor": 4550
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The identifier is not a positive integer.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identifies this request in the service logs. Present on success and failure.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "examples": {
                  "VALIDATION_FAILED": {
                    "value": {
                      "code": "VALIDATION_FAILED",
                      "message": "The request body is not valid.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",
                      "details": [
                        {
                          "field": "lines.0.quantity",
                          "message": "quantity must be at least 1"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No order exists with that identifier.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identifies this request in the service logs. Present on success and failure.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "examples": {
                  "ORDER_NOT_FOUND": {
                    "value": {
                      "code": "ORDER_NOT_FOUND",
                      "message": "No order exists with identifier 9999.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",

  "info": {
    "title": "Order Processing System API",
    "description": "Order Processing System. Create orders, read them back, page through them, and cancel one.\n\n**Authentication.** This API requires no credentials of any kind. There is no key, token, session or\nheader to supply, and no authorisation rule about who may read or cancel whose order. That is a\ndeclared boundary of this system rather than an oversight, and no credential scheme is configured or\nplanned within this scope.\n\n**Money** is always an integer count of the minor unit of the currency, on every field whose name ends\n`Minor`. No field carries a decimal, a floating point value, or a formatted amount.\n\n**Timestamps** are always an integer count of microseconds since the Unix epoch, on every field whose\nname ends `Us`. There is deliberately no formatted or millisecond-precision rendering of an ordering\ntimestamp anywhere in this API, because that is the value a client would reach for when building its\nown pagination cursor, and it is truncated.\n\n**Cursors are opaque.** Read `nextCursor` from a response and pass it back unchanged. Its encoding is\nnot part of this contract, and a cursor a client constructs itself is not supported.\n\n**Errors** all share one body, published as the `ErrorBody` component. Its `code` is stable and\nmachine-readable; branch on that rather than on `message`. No error body contains a stack trace, a\ndriver message, a query fragment or a filesystem path.\n\n**Server errors.** A `500` response carrying the same error body is representable, as it is for any\nservice. It is documented here once rather than on each operation, because no input a caller can\nconstruct produces one, and listing an unprovokable response per operation would weaken the\nguarantee that every documented failure is a failure that has actually been exercised.\n\n**There is no operation that updates or deletes an order.** A stored order is permanent: it always\ncarries at least one line item, line items cannot be deleted, and the order cannot be removed while\na line references it. Cancellation is the answer this lifecycle offers to an unwanted order.\nThere are also no customer or product operations, and no offset-style paging parameter.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Orders",
      "description": "Placing, reading and cancelling orders."
    },
    {
      "name": "Operations",
      "description": "Operational endpoints, outside the versioned API prefix."
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "lines": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "required": [
                "productId",
                "quantity"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "customerId",
          "lines"
        ],
        "additionalProperties": false
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "processing",
          "cancelled"
        ],
        "description": "The lifecycle state of an order. Only pending orders can be promoted or cancelled."
      },
      "OrderLineView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Identifier of this line item, stable across reads."
          },
          "productId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "The product this line was placed against."
          },
          "productDescription": {
            "type": "string",
            "description": "The product description captured when the order was placed."
          },
          "unitPriceMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The catalog price at the moment of placement, in minor units. Unaffected by later catalog changes."
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "How many units of the product this line covers."
          },
          "lineTotalMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Unit price times quantity, in minor units. Computed by the database, never supplied by a caller.",
            "readOnly": true
          }
        },
        "required": [
          "id",
          "productId",
          "productDescription",
          "unitPriceMinor",
          "quantity",
          "lineTotalMinor"
        ],
        "additionalProperties": false
      },
      "OrderView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Identifier of the order."
          },
          "customerId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "The customer the order was placed for."
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "createdAtUs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "When the order was created, in microseconds since the Unix epoch."
          },
          "updatedAtUs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "When the order last changed, in microseconds since the Unix epoch. Never earlier than createdAtUs."
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The sum of the line totals, in minor units. Derived on read and never stored.",
            "readOnly": true
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineView"
            },
            "description": "Never empty, because an order and at least one line are written in one transaction. Returned in ascending line identifier, which is stable across reads."
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "createdAtUs",
          "updatedAtUs",
          "totalMinor",
          "lines"
        ],
        "additionalProperties": false
      },
      "ListOrdersResponse": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderView"
            },
            "description": "The page of orders, newest first."
          },
          "nextCursor": {
            "description": "Opaque continuation token. Pass it back as the cursor parameter to fetch the next page. Null on the final page. Its encoding is not part of this contract and must not be decoded or constructed.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The page size that was applied."
          }
        },
        "required": [
          "orders",
          "nextCursor",
          "limit"
        ],
        "additionalProperties": false
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "The request field the problem concerns."
          },
          "message": {
            "type": "string",
            "description": "What is wrong with it."
          }
        },
        "required": [
          "field",
          "message"
        ],
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "CUSTOMER_NOT_FOUND",
              "PRODUCT_NOT_FOUND",
              "ORDER_NOT_FOUND",
              "ORDER_TOTAL_NOT_REPRESENTABLE",
              "INVALID_CURSOR",
              "INVALID_IDEMPOTENCY_KEY",
              "IDEMPOTENCY_KEY_REUSED",
              "TRANSITION_NOT_PERMITTED",
              "INTERNAL_ERROR"
            ],
            "description": "Stable and machine-readable. Branch on this rather than on the message, which is for a human and is not part of the contract."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation. Never contains a stack trace, a driver message, a query fragment or a filesystem path."
          },
          "correlationId": {
            "type": "string",
            "description": "Identifies this request in the service logs."
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "description": "Names the request fields responsible, where the failure can be attributed to one. Populated for VALIDATION_FAILED, CUSTOMER_NOT_FOUND, PRODUCT_NOT_FOUND, INVALID_CURSOR and INVALID_IDEMPOTENCY_KEY. Empty for ORDER_NOT_FOUND, TRANSITION_NOT_PERMITTED, IDEMPOTENCY_KEY_REUSED and ORDER_TOTAL_NOT_REPRESENTABLE, which concern the state of the system rather than a field you sent."
          }
        },
        "required": [
          "code",
          "message",
          "correlationId",
          "details"
        ],
        "additionalProperties": false
      },
      "HealthReport": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "description": "Healthy only when every dependency is."
          },
          "dependencies": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "healthy",
                "unhealthy"
              ]
            },
            "description": "One entry per checked dependency."
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "additionalProperties": false
      }
    }
  }
}

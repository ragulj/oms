{
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Succeeds only when the service and every dependency are healthy. There is deliberately no\nliveness and readiness split, since the declared scope has no orchestrator to consume one.\n\nThis endpoint sits outside the versioned prefix on purpose, so a supervisor or probe never has\nto track the API version.",
        "operationId": "checkHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The service and every dependency are healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                },
                "example": {
                  "status": "healthy",
                  "dependencies": {
                    "database": "healthy"
                  }
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is unhealthy. The body names which. This response does not use the shared error body, because health reports a state rather than rejecting a request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                },
                "example": {
                  "status": "unhealthy",
                  "dependencies": {
                    "database": "unhealthy"
                  }
                }
              }
            }
          }
        },
        "summary": "Report service and dependency health",
        "tags": [
          "Operations"
        ]
      }
    },
    "/api/v1/orders": {
      "post": {
        "description": "Captures the catalog price of every product at this moment and stores the order and all of its\nline items as one indivisible unit. Nothing you send can influence the price recorded: a request\ncarrying a price, a total, a status, an identifier or a timestamp is rejected rather than having\nthe field ignored.\n\nWithout an `Idempotency-Key` there is no replay protection, so executing this twice creates two\norders. That is the intended behaviour, not a defect: the key is the mechanism that prevents a\nduplicate, and a duplicate cannot be deleted afterwards, only cancelled.",
        "operationId": "createOrder",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "8 to 255 characters of letters, digits, hyphen and underscore. Repeating a request with the same key returns the originally created order with status 200 instead of creating a second one. Omitting it means no replay protection.",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 255
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "description": "Echoed back when well formed. A generated identifier is used when absent or malformed.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "One to 100 line items. Repeating a product across lines is permitted; each line is priced and totalled independently.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "customerId": 1,
                    "lines": [
                      {
                        "productId": 1,
                        "quantity": 3
                      },
                      {
                        "productId": 2,
                        "quantity": 1
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An idempotent replay. The body is the order created by the original request, and no second order exists. The status code is the signal, since the body is identical to the original 201.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identifies this request in the service logs. Present on success and failure.",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotent-Replay": {
                "description": "Present and set to true only on a replay.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                },
                "example": {
                  "id": 42,
                  "customerId": 1,
                  "status": "pending",
                  "createdAtUs": 1757030400123456,
                  "updatedAtUs": 1757030400123456,
                  "totalMinor": 8447,
                  "lines": [
                    {
                      "id": 101,
                      "productId": 1,
                      "productDescription": "Widget",
                      "unitPriceMinor": 1299,
                      "quantity": 3,
                      "lineTotalMinor": 3897
                    },
                    {
                      "id": 102,
                      "productId": 2,
                      "productDescription": "Gadget",
                      "unitPriceMinor": 4550,
                      "quantity": 1,
                      "lineTotalMinor": 4550
                    }
                  ]
                }
              }
            }
          },
          "201": {
            "description": "The order was created.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identifies this request in the service logs. Present on success and failure.",
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "description": "Path at which the created order can be retrieved.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                },
                "example": {
                  "id": 42,
                  "customerId": 1,
                  "status": "pending",
                  "createdAtUs": 1757030400123456,
                  "updatedAtUs": 1757030400123456,
                  "totalMinor": 8447,
                  "lines": [
                    {
                      "id": 101,
                      "productId": 1,
                      "productDescription": "Widget",
                      "unitPriceMinor": 1299,
                      "quantity": 3,
                      "lineTotalMinor": 3897
                    },
                    {
                      "id": 102,
                      "productId": 2,
                      "productDescription": "Gadget",
                      "unitPriceMinor": 4550,
                      "quantity": 1,
                      "lineTotalMinor": 4550
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid, or an identifier does not resolve. Nothing is written, not even the order row. Quantity must be between 1 and 1000000, and an order must carry 1 to 100 lines.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identifies this request in the service logs. Present on success and failure.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "examples": {
                  "VALIDATION_FAILED": {
                    "value": {
                      "code": "VALIDATION_FAILED",
                      "message": "The request body is not valid.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",
                      "details": [
                        {
                          "field": "lines.0.quantity",
                          "message": "quantity must be at least 1"
                        }
                      ]
                    }
                  },
                  "CUSTOMER_NOT_FOUND": {
                    "value": {
                      "code": "CUSTOMER_NOT_FOUND",
                      "message": "No customer exists with identifier 9999.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",
                      "details": [
                        {
                          "field": "customerId",
                          "message": "No customer with identifier 9999."
                        }
                      ]
                    }
                  },
                  "PRODUCT_NOT_FOUND": {
                    "value": {
                      "code": "PRODUCT_NOT_FOUND",
                      "message": "No product exists with identifier 9999.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",
                      "details": [
                        {
                          "field": "lines.productId",
                          "message": "No product with identifier 9999."
                        }
                      ]
                    }
                  },
                  "ORDER_TOTAL_NOT_REPRESENTABLE": {
                    "value": {
                      "code": "ORDER_TOTAL_NOT_REPRESENTABLE",
                      "message": "The order total is larger than can be represented exactly and was not rounded.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",
                      "details": []
                    }
                  },
                  "INVALID_IDEMPOTENCY_KEY": {
                    "value": {
                      "code": "INVALID_IDEMPOTENCY_KEY",
                      "message": "The Idempotency-Key header must be 8 to 255 characters of A-Z, a-z, 0-9, hyphen or underscore.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",
                      "details": [
                        {
                          "field": "Idempotency-Key",
                          "message": "Use 8 to 255 characters of A-Z, a-z, 0-9, hyphen, or underscore."
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "The idempotency key was used before with a different request body. Nothing is written.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identifies this request in the service logs. Present on success and failure.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "examples": {
                  "IDEMPOTENCY_KEY_REUSED": {
                    "value": {
                      "code": "IDEMPOTENCY_KEY_REUSED",
                      "message": "This idempotency key was used before with a different request body.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",
                      "details": []
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Place an order",
        "tags": [
          "Orders"
        ]
      },
      "get": {
        "description": "Keyset pagination only. Read `nextCursor` from the response and pass it back unchanged to fetch\nthe next page; it is null on the final page. Passing the same cursor twice with no intervening\nwrites returns the same page.\n\nThere is no `offset` or `page` parameter, and supplying one is rejected rather than ignored:\naccepting an offset while ignoring it would let a caller believe it was paging when it was\nre-reading the first page. Changing `status` mid-traversal starts a new listing, because the\nfilter applies to the whole set and the cursor only positions within it.",
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Page size, 50 by default and at most 100. A value outside the range is rejected, never clamped, so you never receive fewer items than you asked for without being told.",
            "schema": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque continuation token from a previous response. Its encoding is not part of this contract: do not decode it and do not construct one. A malformed cursor is rejected rather than treated as absent.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Restrict the listing to one status.",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "processing",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of orders. Returned for an empty page too.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identifies this request in the service logs. Present on success and failure.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOrdersResponse"
                },
                "example": {
                  "orders": [
                    {
                      "id": 42,
                      "customerId": 1,
                      "status": "pending",
                      "createdAtUs": 1757030400123456,
                      "updatedAtUs": 1757030400123456,
                      "totalMinor": 8447,
                      "lines": [
                        {
                          "id": 101,
                          "productId": 1,
                          "productDescription": "Widget",
                          "unitPriceMinor": 1299,
                          "quantity": 3,
                          "lineTotalMinor": 3897
                        },
                        {
                          "id": 102,
                          "productId": 2,
                          "productDescription": "Gadget",
                          "unitPriceMinor": 4550,
                          "quantity": 1,
                          "lineTotalMinor": 4550
                        }
                      ]
                    }
                  ],
                  "nextCursor": null,
                  "limit": 50
                }
              }
            }
          },
          "400": {
            "description": "A parameter is out of range, unrecognised, or malformed, including the cursor.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identifies this request in the service logs. Present on success and failure.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "examples": {
                  "VALIDATION_FAILED": {
                    "value": {
                      "code": "VALIDATION_FAILED",
                      "message": "The request body is not valid.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",
                      "details": [
                        {
                          "field": "lines.0.quantity",
                          "message": "quantity must be at least 1"
                        }
                      ]
                    }
                  },
                  "INVALID_CURSOR": {
                    "value": {
                      "code": "INVALID_CURSOR",
                      "message": "The cursor is malformed.",
                      "correlationId": "0f6c8a5e-3d21-4c77-9f0e-2b6a1d4e8c11",
                      "details": [
                        {
                          "field": "cursor",
                          "message": "Use the nextCursor value from a previous page."
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "List orders, newest first",
        "tags": [
          "Orders"
        ]
      }
    },
